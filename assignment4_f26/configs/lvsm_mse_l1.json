{
  "data_config": "configs/scannetpp/iphone/data.json",
  "data_overrides": {
    "batch_size": 4,
    "eval_num_frames": 32
  },
  "model": {
    "patch_size": 8,
    "d_model": 384,
    "n_layers": 8,
    "head_dim": 64,
    "mlp_ratio": 4.0,
    "use_qk_norm": true
  },
  "loss": {
    "l1_weight": 0.1
  },
  "training": {
    "epochs": 100,
    "learning_rate": 0.0002,
    "weight_decay": 0.05,
    "betas": [0.9, 0.95],
    "warmup_steps": 200,
    "grad_clip": 1.0,
    "amp": true,
    "vis_every": 5,
    "output_dir": "outputs/lvsm_mse_l1"
  },
  "num_source_views": 2
}
